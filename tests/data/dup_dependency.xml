<?xml version="1.0" ?>
<sdf3 xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" version="1.0" type="sdf" xsi:noNamespaceSchemaLocation="https://www.es.ele.tue.nl/sdf3/xsd/sdf3-sdf.xsd">
  <applicationGraph>
    <sdf name="g" type="G">
      <actor name="a0" type="A0">
        <port name="p0" type="in" rate="1"/>
        <port name="p1" type="in" rate="1"/>
        <port name="p2" type="out" rate="1"/>
        <port name="p3" type="out" rate="1"/>
      </actor>
      <actor name="a1" type="A1">
        <port name="p0" type="in" rate="1"/>
        <port name="p1" type="in" rate="1"/>
        <port name="p2" type="out" rate="1"/>
        <port name="p3" type="out" rate="1"/>
      </actor>
      <!-- Duplicate dependencies a0 -> a1: depth 0 FIRST, depth 3 LAST.
           Lowest depth (0) must dominate (paper Sec. V, Theorem 1 proof).
           The authors' parser keeps the LAST channel (depth 3). -->
      <channel name="ch0" srcActor="a0" srcPort="p2" dstActor="a1" dstPort="p0"/>
      <channel name="ch1" srcActor="a0" srcPort="p3" dstActor="a1" dstPort="p1" initialTokens="3"/>
      <!-- Duplicate dependencies a1 -> a0: depth 1 FIRST, depth 2 LAST. Minimum is 1. -->
      <channel name="ch2" srcActor="a1" srcPort="p2" dstActor="a0" dstPort="p0" initialTokens="1"/>
      <channel name="ch3" srcActor="a1" srcPort="p3" dstActor="a0" dstPort="p1" initialTokens="2"/>
    </sdf>
    <sdfProperties>
      <actorProperties actor="a0">
        <processor type="proc_0" default="true">
          <executionTime time="4"/>
        </processor>
      </actorProperties>
      <actorProperties actor="a1">
        <processor type="proc_1" default="true">
          <executionTime time="3"/>
        </processor>
      </actorProperties>
    </sdfProperties>
  </applicationGraph>
</sdf3>

<?xml version="1.0" ?>
<sdf3 xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" version="1.0" type="sdf" xsi:noNamespaceSchemaLocation="https://www.es.ele.tue.nl/sdf3/xsd/sdf3-sdf.xsd">
  <!-- Paper Example 1 (Figs. 3-4), with the allocation made forced so the
       optimum is provable by hand: x,z only on r1 (proc_0), y only on r2
       (proc_1). x=a0, y=a1, z=a2.
       Dependencies: x->y depth 0, y->x depth 3, y->z depth 0.
       mu* = 5 (see test_ground_truth.py for the proof). -->
  <applicationGraph>
    <sdf name="g" type="G">
      <actor name="a0" type="A0">
        <port name="p0" type="in" rate="1"/>
        <port name="p1" type="out" rate="1"/>
      </actor>
      <actor name="a1" type="A1">
        <port name="p0" type="in" rate="1"/>
        <port name="p1" type="out" rate="1"/>
        <port name="p2" type="out" rate="1"/>
      </actor>
      <actor name="a2" type="A2">
        <port name="p0" type="in" rate="1"/>
      </actor>
      <channel name="ch0" srcActor="a0" srcPort="p1" dstActor="a1" dstPort="p0"/>
      <channel name="ch1" srcActor="a1" srcPort="p1" dstActor="a0" dstPort="p0" initialTokens="3"/>
      <channel name="ch2" srcActor="a1" srcPort="p2" dstActor="a2" dstPort="p0"/>
    </sdf>
    <sdfProperties>
      <actorProperties actor="a0">
        <processor type="proc_0" default="true">
          <executionTime time="3"/>
        </processor>
      </actorProperties>
      <actorProperties actor="a1">
        <processor type="proc_1" default="true">
          <executionTime time="3"/>
        </processor>
      </actorProperties>
      <actorProperties actor="a2">
        <processor type="proc_0" default="true">
          <executionTime time="2"/>
        </processor>
      </actorProperties>
    </sdfProperties>
  </applicationGraph>
</sdf3>
